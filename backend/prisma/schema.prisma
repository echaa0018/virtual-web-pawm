// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // <--- This works in Prisma 5!
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  
  savedStates SimulationState[]
}

model Simulation {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  image       String?
  category    String   @default("Physics")
  config      Json?
  
  userStates  SimulationState[]
}

model SimulationState {
  id           Int      @id @default(autoincrement())
  userId       Int
  simulationId Int
  name         String   @default("Untitled Experiment")
  data         Json     
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  simulation   Simulation @relation(fields: [simulationId], references: [id])
}